# Copy to backend/.env (never commit .env). Everything is optional for a local demo.

# --- Storage ---------------------------------------------------------------
# SQLite works out of the box; use PostgreSQL for anything shared.
DATABASE_URL=sqlite:///./predictpro.db
# DATABASE_URL=postgresql+psycopg://predictpro:predictpro@localhost:5432/predictpro
# Redis powers caching + leaderboards. Unset -> in-process cache and SQL leaderboards.
# REDIS_URL=redis://localhost:6379/0

# --- Auth --------------------------------------------------------------------
# dev = email/password handled by this API (local only) | supabase = verify Supabase JWTs
AUTH_MODE=dev
JWT_SECRET=change-me-to-a-long-random-string
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWT_SECRET=          # legacy HS256 secret; leave empty to verify via JWKS
# SUPABASE_SERVICE_ROLE_KEY=    # only used to delete the auth user on account deletion

# --- Sports data (server-side only; never ship these to the app) ---------------
# mock = deterministic simulated world with live matches, no keys needed
DATA_PROVIDER=mock
# Per-sport override: football_data | api_sports | mock
# PROVIDER_FOOTBALL=football_data
# PROVIDER_BASKETBALL=api_sports
# FOOTBALL_DATA_API_KEY=
# API_SPORTS_KEY=
PROVIDER_REQUESTS_PER_MINUTE=10

# --- Jobs ----------------------------------------------------------------------
# true = run the scheduler inside the API process (dev). In production run one
# `python -m app.cli worker` and set this to false on the API.
RUN_SCHEDULER=true
LIVE_POLL_SECONDS=30

# --- Ops -------------------------------------------------------------------------
ADMIN_TOKEN=change-me
CORS_ORIGINS=*
