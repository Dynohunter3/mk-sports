# Where the PredictPro API runs. Leave unset in development: the app uses the same host as the
# Expo dev server on port 8000 (works on physical devices on the same Wi-Fi, emulators and web).
# EXPO_PUBLIC_API_URL=https://api.example.com

# Auth: "dev" (email/password handled by the API, plus a demo account) or "supabase".
EXPO_PUBLIC_AUTH_MODE=dev
# Required for EXPO_PUBLIC_AUTH_MODE=supabase (these are public client keys, safe to ship):
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=...
